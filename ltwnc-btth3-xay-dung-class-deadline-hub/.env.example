AUTH_SECRET=
# Auth.js sau reverse proxy / `npm start`: thiếu thì báo UntrustedHost (auth.config.ts cũng đặt trustHost: true).
AUTH_TRUST_HOST=true
# Chỉ dùng ở server nhưng phải có lúc build: trang SSG/ISR và sitemap được tạo khi build.
SITE_URL=http://localhost:3000
# Thư mục chứa data/*.json lúc chạy. Để trống thì dùng ./data. Trên Hostinger phải trỏ ra NGOÀI
# thư mục code (mỗi lần deploy ghi đè thư mục website). File thiếu sẽ tự được chép từ ./data.
DATA_DIR=
